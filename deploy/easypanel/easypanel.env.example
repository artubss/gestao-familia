# Variáveis para o serviço Easypanel casamento-gestao-api (cole no painel; não commitar com senhas reais)

APP_NAME="Gestão Família"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://casamento-gestao.sorio.io
APP_LOCALE=pt
LOCALE_PREFER_BROWSER=false
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
DB_HOST=sorio_casamento-gestao-postgres
DB_PORT=5432
DB_DATABASE=gestao_familia
DB_USERNAME=gestao
DB_PASSWORD=CHANGE_ME_POSTGRES

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Conta inicial (seed no primeiro deploy)
INITIAL_ADMIN_EMAIL=contato@sorio.io
INITIAL_ADMIN_PASSWORD=1JafghRf$243
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_LOCALE=pt
INITIAL_FAMILY_NAME=Nossa família
INITIAL_FAMILY_TIMEZONE=America/Sao_Paulo

# E-mail (Hostinger SMTP ou outro) — necessário para login por código
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contato@sorio.io
MAIL_PASSWORD=CHANGE_ME_MAIL
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contato@sorio.io
MAIL_FROM_NAME="${APP_NAME}"
